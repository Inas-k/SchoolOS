 "chatHtml": "<div class=\"fixed end-5 z-50\" style=\"bottom:max(1.25rem, env(safe-area-inset-bottom))\"><div role=\"dialog\" aria-label=\"Talk to sales\" class=\"absolute end-0 bottom-16 w-[340px] max-w-[calc(100vw-40px)] max-h-[calc(100dvh-96px)] overflow-y-auto overscroll-contain bg-white rounded-2xl shadow-2xl shadow-black/25 p-5 text-start\"><div class=\"flex items-start justify-between gap-2 mb-3\"><div><p class=\"text-base font-bold text-gray-900 mb-1\">Ask us anything</p><p class=\"text-sm text-gray-600 leading-snug\">Leave your details and your question — we'll get back to you soon, or chat instantly on WhatsApp.</p></div><button type=\"button\" aria-label=\"Close\" class=\"text-2xl leading-none text-gray-400 hover:text-gray-600 px-0.5\">×</button></div><form novalidate=\"\"><label class=\"block text-[13px] font-semibold text-gray-700 mb-2.5\">Your name<input required=\"\" autocomplete=\"name\" placeholder=\"Jane Tan\" class=\"w-full mt-1 px-2.5 py-2 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-[#25D366] focus:ring-2 focus:ring-[#25D366]/20\" type=\"text\" name=\"name\"></label><label class=\"block text-[13px] font-semibold text-gray-700 mb-2.5\">Email<input required=\"\" autocomplete=\"email\" dir=\"ltr\" placeholder=\"name@company.com\" class=\"w-full mt-1 px-2.5 py-2 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-[#25D366] focus:ring-2 focus:ring-[#25D366]/20\" type=\"email\" name=\"email\"></label><label class=\"block text-[13px] font-semibold text-gray-700 mb-2.5\">Mobile number<div class=\"flex gap-1.5\" dir=\"ltr\"><select name=\"country_code\" aria-label=\"Country code\" class=\"mt-1 px-2.5 py-2 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-[#25D366] focus:ring-2 focus:ring-[#25D366]/20 w-[108px] flex-none\"><option value=\"SG\">SG +65</option><option value=\"MY\">MY +60</option><option value=\"ID\">ID +62</option><option value=\"TH\">TH +66</option><option value=\"PH\">PH +63</option><option value=\"VN\">VN +84</option><option value=\"IN\" selected=\"\">IN +91</option><option value=\"AE\">AE +971</option><option value=\"SA\">SA +966</option><option value=\"HK\">HK +852</option><option value=\"AU\">AU +61</option><option value=\"NZ\">NZ +64</option><option value=\"GB\">GB +44</option><option value=\"US\">US +1</option><option value=\"CA\">CA +1</option><option value=\"DE\">DE +49</option><option value=\"FR\">FR +33</option><option value=\"NL\">NL +31</option><option value=\"ES\">ES +34</option><option value=\"ZA\">ZA +27</option></select><input required=\"\" autocomplete=\"tel-national\" placeholder=\"9123 4567\" class=\"mt-1 px-2.5 py-2 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-[#25D366] focus:ring-2 focus:ring-[#25D366]/20 flex-1 min-w-0\" type=\"tel\" name=\"mobile\"></div></label><label class=\"block text-[13px] font-semibold text-gray-700 mb-2.5\">Academy / preschool name <span class=\"font-normal text-gray-400\">(optional)</span><input autocomplete=\"organization\" placeholder=\"Sunshine Swim Academy or Little Stars Preschool\" class=\"w-full mt-1 px-2.5 py-2 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-[#25D366] focus:ring-2 focus:ring-[#25D366]/20\" type=\"text\" name=\"company\"></label><label class=\"block text-[13px] font-semibold text-gray-700 mb-2.5\">Number of students<select name=\"student_band\" class=\"w-full mt-1 px-2.5 py-2 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-[#25D366] focus:ring-2 focus:ring-[#25D366]/20\"><option value=\"\" selected=\"\">Just starting out</option><option value=\"1-50\">Under 50</option><option value=\"51-100\">50 - 200</option><option value=\"201-500\">200 - 500</option><option value=\"501-1000\">500+</option></select></label><label class=\"block text-[13px] font-semibold text-gray-700 mb-2.5\">What are you looking for? <span class=\"font-normal text-gray-400\">(optional)</span><textarea name=\"message\" rows=\"2\" placeholder=\"e.g. online bookings and payments, replacing spreadsheets, a website for my academy\" class=\"w-full mt-1 px-2.5 py-2 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-[#25D366] focus:ring-2 focus:ring-[#25D366]/20 resize-y\"></textarea></label><input tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\" class=\"absolute w-px h-px opacity-0 pointer-events-none\" type=\"text\" name=\"website\"><button type=\"submit\" class=\"w-full bg-[#1a1a1a] hover:bg-[#333] disabled:opacity-60 text-white text-[15px] font-semibold py-3 rounded-xl transition-colors\">Contact me</button><p class=\"text-[11px] text-gray-500 leading-snug mt-2.5\">We'll only use this to contact you about Skooly. Support for existing customers is in your Skooly dashboard and app.</p><p class=\"text-[11px] text-gray-400 leading-snug mt-1.5\">Protected by reCAPTCHA — <a href=\"https://policies.google.com/privacy\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"underline\">Privacy</a> &amp; <a href=\"https://policies.google.com/terms\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"underline\">Terms</a>.</p></form></div><button type=\"button\" aria-label=\"Questions? Chat with us\" class=\"inline-flex items-center gap-2 bg-[#1a1a1a] hover:bg-[#333] text-white text-[15px] font-semibold px-5 py-3.5 rounded-full shadow-lg shadow-black/20 transition-colors\"><svg/>Questions? Chat with us</button></div>",
